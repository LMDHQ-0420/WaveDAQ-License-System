{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://license.wavedaq.example/schemas/release-v1.json",
  "title": "WaveDAQ Release",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "product_id", "version", "platform", "asset_url", "sha256", "status"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "product_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "platform": { "type": "string", "enum": ["macos-arm64", "macos-x64", "windows-x64"] },
    "asset_url": { "type": "string", "format": "uri" },
    "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "signature": { "type": ["string", "null"] },
    "status": { "type": "string", "enum": ["active", "hidden"] }
  }
}
