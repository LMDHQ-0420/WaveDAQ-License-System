{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://license.wavedaq.example/schemas/license-v1.json",
  "title": "WaveDAQ Offline License",
  "description": "Cloudflare Worker 签发、由 Launcher 和真实 WaveDAQ 离线验证的授权文件。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "license_id",
    "device_id",
    "device_public_key",
    "issued_at",
    "products",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "license_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{2,127}$"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{2,127}$"
    },
    "device_public_key": {
      "type": "string",
      "description": "Ed25519 公钥，使用 base64url 编码。",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/product_permission"
      }
    },
    "signature": {
      "type": "string",
      "description": "服务器 Ed25519 签名，签名内容为去掉 signature 字段后的规范化 JSON。",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  },
  "$defs": {
    "product_permission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_id", "platforms"],
      "properties": {
        "product_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "macos-arm64",
              "macos-x64",
              "windows-x64"
            ]
          }
        }
      }
    }
  }
}
